<%- include('layout/header') %>
<div class="container dashboard-container">
  <div class="page-header">
    <div>
      <h1 class="page-title">Dashboard</h1>
      <p class="page-subtitle">Welcome back, <strong><%= user.name %></strong>! <% if(user.role==='admin'){ %><span class="badge badge-admin">Admin</span><% } %></p>
    </div>
    <% if (user.role === 'admin') { %><a href="/sessions/new" class="btn btn-primary">+ Create Session</a><% } %>
  </div>

  <!-- My Created Sessions -->
  <section class="dashboard-section">
    <h2 class="section-heading"><span class="section-icon">🎯</span> Sessions I Created</h2>
    <% if (!createdSessions.length) { %>
      <div class="empty-state">
        <div class="empty-icon">📋</div>
        <p>You haven't created any sessions yet.</p>
        <% if (user.role === 'admin') { %><a href="/sessions/new" class="btn btn-primary btn-sm">Create your first session</a><% } %>
      </div>
    <% } else { %>
      <div class="sessions-grid">
        <% createdSessions.forEach(function(s) { %>
          <div class="session-card <%= s.isCancelled ? 'cancelled' : (new Date(s.dateTime) < now ? 'past' : 'active') %>">
            <div class="session-card-header">
              <span class="sport-badge"><%= s.sport ? s.sport.name : 'Sport' %></span>
              <% if (s.isCancelled) { %>
                <span class="status-badge status-cancelled">Cancelled</span>
              <% } else if (new Date(s.dateTime) < now) { %>
                <span class="status-badge status-past">Past</span>
              <% } else { %>
                <span class="status-badge status-active">Active</span>
              <% } %>
            </div>
            <div class="session-card-body">
              <div class="session-meta">
                <span>📍 <%= s.venue %></span>
                <span>📅 <%= new Date(s.dateTime).toLocaleString('en-IN', {dateStyle:'medium', timeStyle:'short'}) %></span>
                <span>👥 <%= s.sessionPlayers.length %> joined / <%= s.additionalPlayersNeeded %> slots</span>
              </div>
              <% if (s.isCancelled && s.cancelReason) { %>
                <div class="cancel-reason">❌ Reason: <%= s.cancelReason %></div>
              <% } %>
            </div>
            <div class="session-card-actions">
              <a href="/sessions/<%= s.id %>" class="btn btn-sm btn-outline">View</a>
              <% if (user.role === 'admin' && !s.isCancelled && new Date(s.dateTime) > now) { %>
                <button class="btn btn-sm btn-danger" onclick="openCancelModal('<%= s.id %>', '<%= csrfToken %>')">Cancel</button>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </section>

  <!-- Joined Sessions -->
  <section class="dashboard-section">
    <h2 class="section-heading"><span class="section-icon">✅</span> Sessions I Joined</h2>
    <% if (!joinedSessions.length) { %>
      <div class="empty-state">
        <div class="empty-icon">🤝</div>
        <p>You haven't joined any sessions yet.</p>
      </div>
    <% } else { %>
      <div class="sessions-grid">
        <% joinedSessions.forEach(function(s) { %>
          <div class="session-card <%= s.isCancelled ? 'cancelled' : (new Date(s.dateTime) < now ? 'past' : 'active') %>">
            <div class="session-card-header">
              <span class="sport-badge"><%= s.sport ? s.sport.name : 'Sport' %></span>
              <% if (s.isCancelled) { %>
                <span class="status-badge status-cancelled">Cancelled</span>
              <% } else if (new Date(s.dateTime) < now) { %>
                <span class="status-badge status-past">Past</span>
              <% } else { %>
                <span class="status-badge status-joined">Joined</span>
              <% } %>
            </div>
            <div class="session-card-body">
              <div class="session-meta">
                <span>🧑 By: <%= s.creator ? s.creator.name : 'Unknown' %></span>
                <span>📍 <%= s.venue %></span>
                <span>📅 <%= new Date(s.dateTime).toLocaleString('en-IN', {dateStyle:'medium', timeStyle:'short'}) %></span>
              </div>
              <% if (s.isCancelled && s.cancelReason) { %>
                <div class="cancel-reason">❌ Cancelled: <%= s.cancelReason %></div>
              <% } %>
            </div>
            <div class="session-card-actions">
              <a href="/sessions/<%= s.id %>" class="btn btn-sm btn-outline">View</a>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </section>

  <!-- Available Sessions -->
  <section class="dashboard-section">
    <h2 class="section-heading"><span class="section-icon">🔍</span> Available Sessions</h2>
    <% if (!available.length) { %>
      <div class="empty-state">
        <div class="empty-icon">🏟️</div>
        <p><%= user.role === 'admin' ? 'No open sessions available right now. Create one!' : 'No open sessions available right now. Please check again later.' %></p>
      </div>
    <% } else { %>
      <div class="sessions-grid">
        <% available.forEach(function(s) { %>
          <div class="session-card active">
            <div class="session-card-header">
              <span class="sport-badge"><%= s.sport ? s.sport.name : 'Sport' %></span>
              <span class="status-badge status-open"><%= s.additionalPlayersNeeded %> slots open</span>
            </div>
            <div class="session-card-body">
              <div class="session-meta">
                <span>🧑 By: <%= s.creator ? s.creator.name : 'Unknown' %></span>
                <span>📍 <%= s.venue %></span>
                <span>📅 <%= new Date(s.dateTime).toLocaleString('en-IN', {dateStyle:'medium', timeStyle:'short'}) %></span>
              </div>
            </div>
            <div class="session-card-actions">
              <a href="/sessions/<%= s.id %>" class="btn btn-sm btn-outline">View</a>
              <form action="/sessions/<%= s.id %>/join" method="POST" style="display:inline;">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <button type="submit" class="btn btn-sm btn-primary">Join</button>
              </form>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </section>
</div>

<!-- Cancel Modal -->
<div id="cancelModal" class="modal-overlay" style="display:none;">
  <div class="modal">
    <h3>Cancel Session</h3>
    <p>Please provide a reason for cancellation (shown to joined players):</p>
    <form id="cancelForm" method="POST">
      <input type="hidden" name="_csrf" id="cancelCsrf" value="" />
      <textarea name="cancelReason" class="form-control" rows="3" placeholder="Reason for cancellation..." required></textarea>
      <div class="modal-actions">
        <button type="button" class="btn btn-outline" onclick="closeModal()">Cancel</button>
        <button type="submit" class="btn btn-danger">Confirm Cancel</button>
      </div>
    </form>
  </div>
</div>

<script>
function openCancelModal(id, csrf) {
  document.getElementById('cancelForm').action = '/sessions/' + id + '/cancel';
  document.getElementById('cancelCsrf').value = csrf;
  document.getElementById('cancelModal').style.display = 'flex';
}
function closeModal() {
  document.getElementById('cancelModal').style.display = 'none';
}
</script>
<%- include('layout/footer') %>
